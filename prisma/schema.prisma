generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
    frontend
    backend
    design
}

enum Seniority {
    junior
    semi_senior
    senior
}

model Worker {
  id      Int      @id @default(autoincrement())
  name    String
  role    Role
  seniority Seniority
  projects  Project[]
}

model Project {
  id      Int      @id @default(autoincrement())
  name    String
  client  String
  start_date   DateTime
  finish_date  DateTime
  workers      Worker[]
}