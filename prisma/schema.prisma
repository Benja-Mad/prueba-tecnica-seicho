generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
    frontend
    backend
    design
}

enum Seniority {
    junior
    semi_senior
    senior
}

model Developer {
  id      Int      @id @default(autoincrement())
  name    String
  role    Role
  seniority Seniority
}